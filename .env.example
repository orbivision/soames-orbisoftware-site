# WordPress GraphQL endpoint the Soames Astro front end reads at dev/build time.
# Copy this file to `.env`. Netlify supplies the same value as a build env var.
#
# Note: WordPress lives at orbivision.net, which 301s to orbisoftware.com — but
# /graphql and /wp-json are excluded from that redirect, so this URL works as-is.
WORDPRESS_GRAPHQL_URL=https://orbivision.net/graphql
